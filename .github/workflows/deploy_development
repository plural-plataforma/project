name: Build & Deploy to MonsterASP

on:
  push:
    branches: [ staiging ]          # ou master, ou a branch que você usa em produção

jobs:
  build-and-deploy:
    runs-on: windows-latest     # importante: MonsterASP é Windows/IIS

    steps:
    - uses: actions/checkout@v4

    - name: Setup .NET
      uses: actions/setup-dotnet@v4
      with:
        dotnet-version: '8.0.x'   # ajuste para sua versão (8, 9, etc.)

    - name: Restore dependencies
      run: dotnet restore

    - name: Build
      run: dotnet build --configuration Release --no-restore

    - name: Publish
      run: dotnet publish --configuration Release --no-build --output ./publish

    - name: Deploy via WebDeploy
      uses: glennjones/webdeploy-msdeploy-action@v1.0.0   # ou outra action compatível
      with:
        publishProfile: ${{ secrets.MONSTERASP_PUBLISH_PROFILE_DEVELOPMENT }}
        package: ./publish
