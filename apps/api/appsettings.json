{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppDbContext": "Host={HOST_SUPABASE};Port=5432;Database=postgres;Username=postgres;Password={DB_PASSWORD};SSL Mode=Require;Trust Server Certificate=true"
  },
  "JwtSettings": {
    "Secret": "{JWT_SECRET}", 
    "Issuer": "PluralAPI",
    "Audience": "PluralAPIUsuarios",
    "ExpirationMinutes": 60
  }
}