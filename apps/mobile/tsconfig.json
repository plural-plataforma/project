{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../*"],
      "packages/ui/components/*": ["../../packages/ui/components/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "expo.d.ts"]
}