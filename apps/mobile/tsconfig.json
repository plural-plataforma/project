{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@*": [
        "./*"
      ],
      "@packages/ui/*": [
        "../../packages/ui/*"
      ],
      "app": [
        "apps/mobile/src/*"
      ],
      "types/*": [
        "src/types/*"
      ]
    },
    "types": [
      "node",
       "react-native",
      "@types/react-native"
    ] // ← Adicione isso aqui! (ou mantenha se já tiver)
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "src/types/expo.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}