{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      
      "@/*": ["../../*"],
      "@*": ["./*"],
      "packages/ui/components/*": ["../../packages/ui/components/*"],
      "app": ["apps/mobile/src/*"],
      "-types":["types/*"]

    },
    "types": ["react-native", "@types/react-native",]
  },
  "include": ["**/*.ts", "**/*.tsx", "src/types/expo.d.ts"]
}