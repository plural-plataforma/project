{
  "name": "plural-plataforma",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "dependencies": {
    "expo": "~54.0.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "^0.81.4"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "~19.1.10",
    "cross-env": "^7.0.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.6.2",
    "turbo": "latest",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.39.1",
    "dotenv": "^16.1.4"
  },
  "overrides": {
  "react": "19.1.0",
  "react-dom": "19.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.5.2"
}
